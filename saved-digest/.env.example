# Copy to .env, fill in, then:  set -a; source .env; set +a

# --- Claude (required for summarise + verify) -----------------------------
ANTHROPIC_API_KEY=sk-ant-...
# SAVED_DIGEST_MODEL=claude-opus-5
# SAVED_DIGEST_EFFORT=medium
# Bounds cost per fact-checked item. Simple checks use 1-3 searches.
# SAVED_DIGEST_MAX_SEARCHES=4

# --- Delivery (required to send) ------------------------------------------
SAVED_DIGEST_TO=you@example.com
# Entries in the email body per send. Footer counts are never truncated.
# SAVED_DIGEST_ITEM_LIMIT=12

# --- Instagram capture, via Todoist ---------------------------------------
# Todoist -> Settings -> Integrations -> Developer
TODOIST_API_TOKEN=
# SAVED_DIGEST_TODOIST_PROJECT=Saved from Instagram

# --- YouTube --------------------------------------------------------------
# The ordinary playlist you save into. Watch Later cannot be read by any API.
# SAVED_DIGEST_PLAYLIST_TITLE=To Watch
# Skip the by-title lookup if you know the id.
# SAVED_DIGEST_PLAYLIST_ID=

# Only for the one-time Watch Later backlog import, and for --deep on private
# Instagram posts. chrome | firefox | edge | brave | safari | chromium | opera
# SAVED_DIGEST_COOKIES_BROWSER=chrome

# --- Batch sizes ----------------------------------------------------------
# Items per stage per run. Keeps the first run on a big backlog affordable.
# SAVED_DIGEST_STAGE_LIMIT=50

# --- Paths (default to XDG) ----------------------------------------------
# SAVED_DIGEST_CONFIG_DIR=~/.config/saved-digest
# SAVED_DIGEST_DATA_DIR=~/.local/share/saved-digest
